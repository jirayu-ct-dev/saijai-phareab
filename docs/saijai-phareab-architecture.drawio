        <mxCell id="sub3" value="เส้นทางตั้งแต่พนักงานรับผ้าจนถึงแจ้งลูกค้าและพิมพ์เอกสาร" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="60" y="82" width="900" height="30" as="geometry"/></mxCell>

        <mxCell id="f1" value="&lt;b style=&quot;font-size:20px&quot;&gt;1&lt;/b&gt;&lt;br&gt;&lt;b&gt;พนักงานสร้างออเดอร์&lt;/b&gt;&lt;br&gt;เลือกบริการ ลูกค้า แพ็กเกจ&lt;br&gt;วันนัดรับ และการชำระเงิน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontSize=15;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="f2" value="&lt;b style=&quot;font-size:20px&quot;&gt;2&lt;/b&gt;&lt;br&gt;&lt;b&gt;Nitro API ตรวจสอบ&lt;/b&gt;&lt;br&gt;Session • Role • Input&lt;br&gt;ราคาและสิทธิ์แพ็กเกจ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=15;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="390" y="190" width="250" height="150" as="geometry"/></mxCell>
