        <mxCell id="f4" value="&lt;b style=&quot;font-size:20px&quot;&gt;4&lt;/b&gt;&lt;br&gt;&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;บันทึกข้อมูลแบบ atomic&lt;br&gt;พร้อมเลขออเดอร์/เอกสาร" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=15;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="1030" y="185" width="230" height="165" as="geometry"/></mxCell>
        <mxCell id="f5" value="&lt;b style=&quot;font-size:20px&quot;&gt;5&lt;/b&gt;&lt;br&gt;&lt;b&gt;แจ้งลูกค้า&lt;/b&gt;&lt;br&gt;LINE Message / Rich Menu&lt;br&gt;ตามการตั้งค่าแจ้งเตือน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;fontSize=15;fontColor=#581C87;" vertex="1" parent="1"><mxGeometry x="1320" y="190" width="220" height="150" as="geometry"/></mxCell>

        <mxCell id="printlane" value="PRINTING PATH — cloud server สร้างเอกสาร แต่ browser เป็นผู้เรียก LAN Gateway" style="swimlane;horizontal=1;startSize=45;rounded=1;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontStyle=1;fontSize=15;fontColor=#7C2D12;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="1470" height="290" as="geometry"/></mxCell>
        <mxCell id="p1" value="&lt;b&gt;6. ขอเอกสาร&lt;/b&gt;&lt;br&gt;Receipt / Quotation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;fontSize=15;fontColor=#7C2D12;" vertex="1" parent="printlane"><mxGeometry x="40" y="90" width="210" height="95" as="geometry"/></mxCell>
        <mxCell id="p2" value="&lt;b&gt;7. Server Render&lt;/b&gt;&lt;br&gt;Trusted payment/order data&lt;br&gt;Hybrid ESC/POS bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;fontSize=15;fontColor=#7C2D12;" vertex="1" parent="printlane"><mxGeometry x="315" y="80" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="p3" value="&lt;b&gt;8. Browser&lt;/b&gt;&lt;br&gt;รับ binary response&lt;br&gt;เลือก trusted printer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;fontSize=15;fontColor=#7C2D12;" vertex="1" parent="printlane"><mxGeometry x="630" y="80" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="p4" value="&lt;b&gt;9. LAN Gateway&lt;/b&gt;&lt;br&gt;CORS • private client • mutex&lt;br&gt;bounded payload • no retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=15;fontColor=#7C2D12;" vertex="1" parent="printlane"><mxGeometry x="925" y="80" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="p5" value="&lt;b&gt;10. Thermal Printer&lt;/b&gt;&lt;br&gt;TCP port 9100&lt;br&gt;พิมพ์และตัดกระดาษ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;fontSize=15;fontColor=#7C2D12;" vertex="1" parent="printlane"><mxGeometry x="1240" y="80" width="190" height="115" as="geometry"/></mxCell>

        <mxCell id="fe1" value="HTTPS / JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#64748B;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe2" value="validated input" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2563EB;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe3" value="commit / rollback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#16A34A;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe4" value="after success" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9333EA;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#EA580C;endArrow=block;endFill=1;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe2" value="binary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#EA580C;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe3" value="POST /print/:id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#EA580C;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe4" value="send once" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#EA580C;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="note3" value="SENT = ส่ง bytes ถึง transport แล้ว ไม่ได้ยืนยันว่ากระดาษออกสำเร็จ  •  UNKNOWN_PROGRESS = ต้องตรวจเครื่องจริงก่อน retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="250" y="805" width="1100" height="55" as="geometry"/></mxCell>
