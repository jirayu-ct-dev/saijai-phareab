# ============================================================
# .env.example — แม่แบบ environment variables
# คัดลอกเป็น .env แล้วแก้ค่าตามจริง
#   cp .env.example .env
# ============================================================

# ---- Database (PostgreSQL) ----
# Production: replace USER, PASSWORD, HOST, and DATABASE; require TLS when supported.
# Local Compose overrides these values internally.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PRISMA_POOL_MAX=1

# ---- Better Auth ----
BETTER_AUTH_URL=http://localhost:3004
BETTER_AUTH_SECRET=change-me-to-a-random-64-char-string
BETTER_AUTH_TRUSTED_ORIGINS=
TRUSTED_PROXIES=127.0.0.1,::1

# ---- LINE LIFF ----
NUXT_PUBLIC_LIFF_ID=
LINE_LIFF_CLIENT_ID=
LINE_LIFF_CLIENT_SECRET=

# ---- LINE Messaging API ----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_MESSAGING_API=https://api.line.me
LINE_MESSAGING_DATA_API=https://api-data.line.me
LINE_MESSAGING_OAUTH_ISSUE_TOKENV3=https://api.line.me/oauth2/v3/token

# ---- LINE Business Chat ----
LINE_BIZ_CHAT_URL=

# ---- Cloudinary (Images) ----
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Payment QR (server-only) ----
# JSON keyring: version -> base64-encoded 32-byte AES key. Generate the key
# with `openssl rand -base64 32`; never expose this value to the browser.
PAYMENT_QR_RECEIVER_KEYS=

# ---- Resend (Email) ----
RESEND_API_KEY=
RESEND_FROM=SaiJai Laundry <onboarding@resend.dev>

# ---- App ----
# For a Cloudflare Tunnel, set BETTER_AUTH_URL and NUXT_PUBLIC_BASE_URL to the
# public HTTPS URL, set NUXT_PUBLIC_HOSTNAME to its hostname without https://,
# and include both the public origin and any local origins you use in
# BETTER_AUTH_TRUSTED_ORIGINS.
NUXT_PUBLIC_HOSTNAME=localhost
NUXT_PUBLIC_BASE_URL=http://localhost:3004
INTERNAL_BASE_URL=http://127.0.0.1:3000

# Production app example for saijaiphareab.shop:
# BETTER_AUTH_URL=https://saijaiphareab.shop
# BETTER_AUTH_TRUSTED_ORIGINS=https://saijaiphareab.shop
# NUXT_PUBLIC_HOSTNAME=saijaiphareab.shop
# NUXT_PUBLIC_BASE_URL=https://saijaiphareab.shop
# INTERNAL_BASE_URL=http://127.0.0.1:3000

# ---- Cron ----
CRON_SECRET=change-me-to-a-random-secret
PACKAGE_EXPIRY_NOTIFY_DAYS=7,3,1

# ---- Document rendering (optional) ----
# Absolute path to a Chrome/Chromium executable for PDF/receipt rendering.
# Leave empty to use the bundled serverless Chromium.
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome

# ---- LAN Print Gateway ----
# App/browser-visible values. Production must use a stable HTTPS URL trusted by
# every shop device. Set enabled=false until the Gateway is provisioned.
NUXT_PUBLIC_PRINT_GATEWAY_ENABLED=false
NUXT_PUBLIC_PRINT_GATEWAY_URL=http://127.0.0.1:17321
# Keep browser-direct USB/Bluetooth available as fallback.
NUXT_PUBLIC_PRINT_LEGACY_DIRECT=true

# Gateway-host values. Native Node uses PRINT_GATEWAY_BIND_HOST. Docker always
# binds the process to 0.0.0.0 inside its isolated network, while
# PRINT_GATEWAY_PUBLISH_HOST controls whether the host exposes it only locally
# or to the shop LAN. Keep real CIDR, secret and TLS paths only in the host
# .env (chmod 600); do not commit them. The current physical self-test confirms
# raw TCP port 9100; the final shop printer IP remains site-specific.
PRINT_GATEWAY_BIND_HOST=127.0.0.1
# Compose host publish address; keep loopback for local development.
PRINT_GATEWAY_PUBLISH_HOST=127.0.0.1
PRINT_GATEWAY_PORT=17321
PRINT_GATEWAY_PUBLIC_URL=http://127.0.0.1:17321
PRINT_GATEWAY_ALLOWED_ORIGINS=http://localhost:3004,http://127.0.0.1:3004
PRINT_GATEWAY_DISCOVERY_CIDRS=127.0.0.1/32
PRINT_GATEWAY_DISCOVERY_PORTS=19100
PRINT_GATEWAY_DISCOVERY_TIMEOUT_MS=500
PRINT_GATEWAY_DISCOVERY_CONCURRENCY=16
PRINT_GATEWAY_RESCAN_TTL_MS=30000
# Required for native/production use. Docker's loopback-only local profile has
# an isolated development fallback; never reuse that fallback in production.
PRINT_GATEWAY_PAIRING_SECRET=
PRINT_GATEWAY_PAIRING_CODE_TTL_SECONDS=300
PRINT_GATEWAY_TOKEN_TTL_DAYS=90
PRINT_GATEWAY_MAX_PAYLOAD_BYTES=2000000
PRINT_GATEWAY_TCP_TIMEOUT_MS=10000
# Development diagnostics only. Logs length/hash/short hex previews at the
# Gateway and TCP boundaries; production mode always disables it.
PRINT_GATEWAY_DEBUG_BYTES=false
PRINT_GATEWAY_STATE_PATH=./print-bridge/gateway-state.json
# Production Gateway only:
# PRINT_GATEWAY_TLS_CERT_PATH=/run/secrets/tls.crt
# PRINT_GATEWAY_TLS_KEY_PATH=/run/secrets/tls.key
# PRINT_GATEWAY_TLS_CERT_HOST_PATH=/absolute/host/path/tls.crt
# PRINT_GATEWAY_TLS_KEY_HOST_PATH=/absolute/host/path/tls.key

# ---- Home/mobile-hotspot physical test only ----
# Latest self-test confirms Wi-Fi STA/TCP Server at this temporary DHCP endpoint.
# Do not copy this CIDR into shop production configuration.
# PRINT_GATEWAY_DISCOVERY_CIDRS=172.20.10.2/32
# PRINT_GATEWAY_DISCOVERY_PORTS=9100

# ---- Production example: saijaiphareab.shop + final shop printer IP ----
# Keep this block commented in the template. Copy the required values to the
# real .env files only after DNS/TLS and the printer self-test values are ready.
#
# App host (browser-visible):
# NUXT_PUBLIC_PRINT_GATEWAY_ENABLED=true
# NUXT_PUBLIC_PRINT_GATEWAY_URL=https://print.saijaiphareab.shop:17321
# NUXT_PUBLIC_PRINT_LEGACY_DIRECT=true
#
# Gateway host inside the shop:
# PRINT_GATEWAY_BIND_HOST=0.0.0.0
# PRINT_GATEWAY_PUBLISH_HOST=0.0.0.0
# PRINT_GATEWAY_PORT=17321
# PRINT_GATEWAY_PUBLIC_URL=https://print.saijaiphareab.shop:17321
# PRINT_GATEWAY_ALLOWED_ORIGINS=https://saijaiphareab.shop
# Scan only the confirmed printer instead of an entire shop subnet. Replace the
# placeholder from the printer self-test/configuration page; do not reuse a
# hypothetical address from documentation.
# PRINT_GATEWAY_DISCOVERY_CIDRS=REPLACE_WITH_CONFIRMED_PRINTER_IP/32
# Latest physical self-test confirms raw TCP port 9100:
# PRINT_GATEWAY_DISCOVERY_PORTS=9100
# PRINT_GATEWAY_PAIRING_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_48_OUTPUT
# PRINT_GATEWAY_TLS_CERT_HOST_PATH=/absolute/host/path/print.saijaiphareab.shop.crt
# PRINT_GATEWAY_TLS_KEY_HOST_PATH=/absolute/host/path/print.saijaiphareab.shop.key

# ---- Server ----
APP_PORT=3004
IMAGE_TAG=latest
PORT=3000
NITRO_PORT=3000
NODE_ENV=production
