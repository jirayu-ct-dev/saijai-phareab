# ============================================================
# .env.example — แม่แบบ environment variables
# คัดลอกเป็น .env แล้วแก้ค่าตามจริง
#   cp .env.example .env
# ============================================================

# ---- Database (PostgreSQL) ----
# Production: replace USER, PASSWORD, HOST, and DATABASE; require TLS when supported.
# Local Compose overrides these values internally.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PRISMA_POOL_MAX=1

# ---- Better Auth ----
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-random-64-char-string
BETTER_AUTH_TRUSTED_ORIGINS=
TRUSTED_PROXIES=127.0.0.1,::1

# ---- LINE LIFF ----
NUXT_PUBLIC_LIFF_ID=
LINE_LIFF_CLIENT_ID=
LINE_LIFF_CLIENT_SECRET=

# ---- LINE Messaging API ----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_MESSAGING_API=https://api.line.me
LINE_MESSAGING_DATA_API=https://api-data.line.me
LINE_MESSAGING_OAUTH_ISSUE_TOKENV3=https://api.line.me/oauth2/v3/token

# ---- LINE Business Chat ----
LINE_BIZ_CHAT_URL=

# ---- Cloudinary (Images) ----
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Resend (Email) ----
RESEND_API_KEY=
RESEND_FROM=SaiJai Laundry <onboarding@resend.dev>

# ---- App ----
NUXT_PUBLIC_HOSTNAME=localhost
NUXT_PUBLIC_BASE_URL=http://localhost:3000
INTERNAL_BASE_URL=http://127.0.0.1:3000

# ---- Cron ----
CRON_SECRET=change-me-to-a-random-secret
PACKAGE_EXPIRY_NOTIFY_DAYS=7,3,1

# ---- Server ----
APP_PORT=3000
IMAGE_TAG=latest
PORT=3000
NITRO_PORT=3000
NODE_ENV=production
