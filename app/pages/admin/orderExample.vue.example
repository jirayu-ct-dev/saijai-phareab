<script setup lang="ts">
import { h, resolveComponent } from 'vue'
import type { TableColumn } from '@nuxt/ui'
import { getPaginationRowModel } from '@tanstack/table-core'
import type { Row } from '@tanstack/table-core'
import { upperFirst } from 'scule'
import type { Order, OrderType, User, UsedBonus } from '~/types'
import { formatCurrency, formatDateTime } from '~/utils/format'

import {
  ORDER_STATUS_BADGE_MAP,
  ORDER_TYPE_BADGE_MAP,
  ORDER_STATUS_FILTER_OPTIONS,
  ORDER_TYPE_FILTER_OPTIONS,
  ORDER_TYPE_OPTIONS,
  type OrderStatusFilterValue,
  type OrderTypeFilterValue
} from '~/constants/orders'

/**
 * Admin Orders Page
 * แสดงรายการออเดอร์ด้วย Nuxt UI Data Table + Mock data
 */

const UAvatar = resolveComponent('UAvatar')
const UButton = resolveComponent('UButton')
const UBadge = resolveComponent('UBadge')
const UDropdownMenu = resolveComponent('UDropdownMenu')
const UCheckbox = resolveComponent('UCheckbox')
const UTooltip = resolveComponent('UTooltip')

const notify = useNotify()
const table = useTemplateRef<any>('table')
const columnVisibility = ref<Record<string, boolean>>({})
const rowSelection = ref<Record<string, boolean>>({})

const pagination = ref({
  pageIndex: 0,
  pageSize: 10
})

const searchQuery = ref('')
const showDeleteModal = ref(false)
const showAddOrderModal = ref(false)
const showSingleDeleteModal = ref(false)
const deletingOrder = ref<Order | null>(null)
const statusFilter = ref<OrderStatusFilterValue>('all')
const typeFilter = ref<OrderTypeFilterValue>('all')

// Add Order Form
const newOrderForm = reactive({
  orderType: undefined as OrderType | undefined,
  customerId: undefined as string | undefined,
  notes: ''
})
const customerSearchQuery = ref('')
const isCreatingOrder = ref(false)

const blurActiveElement = () => {
  if (typeof document === 'undefined') return
  const active = document.activeElement as HTMLElement | null
  active?.blur()
}

// Fetch users for customer selection
const { data: allUsers } = useAsyncData<User[]>(
  'order-customers',
  async () => {
    const response = await $fetch<User[]>('/api/users')
    return response
  },
  { default: () => [] }
)

// Filter only customers (role = 'User') and search
const filteredCustomers = computed(() => {
  const customers = allUsers.value?.filter(u => u.role === 'User') ?? []
  const keyword = customerSearchQuery.value.trim().toLowerCase()

  if (!keyword) return customers

  return customers.filter((customer) =>
    [customer.name, customer.email, customer.phoneNumber].some((field) =>
      field?.toLowerCase().includes(keyword)
    )
  )
})

// Get selected customer object
const selectedCustomer = computed(() => {
  if (!newOrderForm.customerId) return null
  return allUsers.value?.find(u => u.id === newOrderForm.customerId) ?? null
})

const { data: orders, status } = useAsyncData<Order[]>(
  'admin-orders',
  async () => {
    const response = await $fetch<Order[]>('/api/orders')
    return response
  },
  { default: () => [] }
)

const filteredOrders = computed<Order[]>(() => {
  if (!orders.value) return []

  const keyword = searchQuery.value.trim().toLowerCase()
  const orderStatus = statusFilter.value
  const orderType = typeFilter.value

  return orders.value.filter((order) => {
    const matchKeyword = keyword
      ? [
        order.id,
        order.customer?.name,
        order.customer?.email,
        order.customer?.phoneNumber,
        order.basket?.label
      ].some((field) => field?.toLowerCase().includes(keyword))
      : true
    const matchStatus = orderStatus === 'all' ? true : order.currentStatus === orderStatus
    const matchType = orderType === 'all' ? true : order.orderType === orderType

    return matchKeyword && matchStatus && matchType
  })
})

const selectedRows = computed<Row<Order>[]>(() => {
  return table.value?.tableApi?.getFilteredSelectedRowModel().rows ?? []
})

const selectedOrders = computed<Order[]>(() => selectedRows.value.map((row) => row.original))
const selectedRowsCount = computed(() => selectedRows.value.length)
const filteredRowCount = computed(() => table.value?.tableApi?.getFilteredRowModel().rows.length ?? filteredOrders.value.length)

watch(selectedRowsCount, (count) => {
  if (!count) {
    showDeleteModal.value = false
  }
})

// Reset form when modal closes
watch(showAddOrderModal, (open) => {
  if (!open) {
    resetNewOrderForm()
  }
})

const openAddOrderModal = () => {
  blurActiveElement()
  showAddOrderModal.value = true
}

const openBulkDeleteModal = () => {
  blurActiveElement()
  showDeleteModal.value = true
}

const resetNewOrderForm = () => {
  newOrderForm.orderType = undefined
  newOrderForm.customerId = undefined
  newOrderForm.notes = ''
  customerSearchQuery.value = ''
}

const handleCreateOrder = async () => {
  if (!newOrderForm.orderType) {
    notify.warning('กรุณาเลือกประเภทออเดอร์')
    return
  }
  if (!newOrderForm.customerId) {
    notify.warning('กรุณาเลือกลูกค้า')
    return
  }

  try {
    isCreatingOrder.value = true
    // TODO: เชื่อมต่อ API POST /api/orders
    await new Promise(resolve => setTimeout(resolve, 600))
    notify.created('ออเดอร์')
    showAddOrderModal.value = false
    resetNewOrderForm()
  } finally {
    isCreatingOrder.value = false
  }
}

const handleOrdersRemoved = (removedOrders: Order[]) => {
  if (!orders.value?.length || !removedOrders.length) return

  const removeIds = new Set(removedOrders.map((removed) => removed.id))
  orders.value = orders.value.filter((order) => !removeIds.has(order.id))
  table.value?.tableApi?.resetRowSelection()
  showDeleteModal.value = false
  showSingleDeleteModal.value = false
  deletingOrder.value = null

  notify.deleted(`ออเดอร์ ${removedOrders.length} รายการ`)
}

const openSingleDeleteModal = (order: Order) => {
  // Delay to allow dropdown to close first (prevents aria-hidden warning)
  setTimeout(() => {
    blurActiveElement()
    deletingOrder.value = order
    showSingleDeleteModal.value = true
  }, 100)
}

const confirmSingleDelete = () => {
  if (!deletingOrder.value) return
  handleOrdersRemoved([deletingOrder.value])
}

const handleOrderDeselected = (order: Order) => {
  const rows: Row<Order>[] = table.value?.tableApi?.getRowModel().rows ?? []
  const rowIndex = rows.findIndex((row) => row.original.id === order.id)
  if (rowIndex >= 0) {
    rows[rowIndex]?.toggleSelected(false)
  }
}

const getRowItems = (row: Row<Order>) => {
  return [
    {
      type: 'label',
      label: 'การดำเนินการ'
    },
    {
      label: 'อัปเดตสถานะ',
      icon: 'i-lucide-refresh-cw',
      onSelect() {
        // TODO: ใส่ฟังก์ชันอัปเดตสถานะ
        notify.info('เปิดหน้าต่างอัปเดตสถานะออเดอร์ ' + row.original.id)
      }
    },
    {
      label: 'แก้ไขออเดอร์',
      icon: 'i-lucide-edit-3',
      onSelect() {
        // TODO: ใส่ฟังก์ชันแก้ไข
        notify.info('เปิดหน้าต่างแก้ไขออเดอร์ ' + row.original.id)
      }
    },
    {
      label: 'คัดลอก ID ออเดอร์',
      icon: 'i-lucide-copy',
      onSelect() {
        if (typeof window === 'undefined') return
        navigator.clipboard.writeText(row.original.id.toString())
        notify.info('คัดลอกรหัสออเดอร์แล้ว')
      }
    },
    {
      type: 'separator'
    },
    {
      label: 'ลบออเดอร์นี้',
      icon: 'i-lucide-trash',
      color: 'error',
      onSelect() {
        openSingleDeleteModal(row.original)
      }
    }
  ]
}

const confirmDeleteSelectedOrders = () => {
  if (!selectedOrders.value.length) return
  handleOrdersRemoved([...selectedOrders.value])
}

const cycleColumnSorting = (column: any) => {
  const current = column.getIsSorted?.()
  if (!current) {
    column.toggleSorting?.(false)
  } else if (current === 'asc') {
    column.toggleSorting?.(true)
  } else {
    column.clearSorting?.()
  }
}

/**
 * แสดงยอดที่ต้องจ่ายหรือเครดิตที่ใช้ตามประเภทออเดอร์
 * - PACKAGE: แสดงเครดิตที่ใช้ (creditUsed)
 * - STOREFRONT: แสดงยอดเงิน (totalAmount)
 */
const getOrderAmountDisplay = (order: Order): string => {
  if (order.orderType === 'PACKAGE') {
    return `- ${order.creditUsed} เครดิต`
  }
  return formatCurrency(order.totalAmount)
}

const columns: TableColumn<Order>[] = [
  {
    id: 'select',
    header: ({ table }) =>
      h('div', h(UCheckbox, {
        'modelValue': table.getIsSomePageRowsSelected()
          ? 'indeterminate'
          : table.getIsAllPageRowsSelected(),
        'onUpdate:modelValue': (value: boolean | 'indeterminate') =>
          table.toggleAllPageRowsSelected(!!value),
        'ariaLabel': 'Select all'
      })),
    cell: ({ row }) =>
      h('div', h(UCheckbox, {
        'modelValue': row.getIsSelected(),
        'onUpdate:modelValue': (value: boolean | 'indeterminate') => row.toggleSelected(!!value),
        'ariaLabel': 'Select row'
      }))
  },
  {
    accessorKey: 'id',
    header: ({ column }) => {
      const isSorted = column.getIsSorted()
      const icon = !isSorted
        ? 'i-lucide-arrow-up-down'
        : isSorted === 'asc'
          ? 'i-lucide-arrow-up-narrow-wide'
          : 'i-lucide-arrow-down-wide-narrow'

      return h(UButton, {
        label: 'รหัสออเดอร์',
        color: 'neutral',
        variant: 'ghost',
        class: '-mx-2.5',
        icon,
        onClick: () => cycleColumnSorting(column)
      })
    },
    cell: ({ row }) => {
      return h('span', { class: 'font-mono text-sm' }, row.original.id)
    }
  },
  {
    accessorKey: 'customer',
    header: 'ลูกค้า',
    cell: ({ row }) => {
      const isWalkIn = row.original.isWalkIn
      const customer = row.original.customer

      if (!isWalkIn && !customer) return '-'

      const displayName = isWalkIn
        ? (row.original.walkInName || 'ลูกค้าหน้าร้าน (Walk-in)')
        : (customer?.name || '-')

      const displayPhone = isWalkIn
        ? (row.original.walkInPhone || '-')
        : (customer?.phoneNumber || customer?.email || '')

      const displayImage = isWalkIn ? undefined : customer?.image

      return h('div', { class: 'flex items-center gap-3' }, [
        h(UAvatar, {
          src: displayImage,
          alt: displayName,
          size: 'md'
        }),
        h('div', { class: 'w-32 sm:w-40 space-y-0.5' }, [
          h('div', { class: 'flex items-center gap-1.5' }, [
            h('p', { class: 'font-medium text-highlighted truncate' }, displayName),
            isWalkIn ? h(UBadge, { color: 'amber', variant: 'subtle', size: 'xs', class: 'text-[9px] px-1 py-0 h-4' }, () => 'Walk-in') : null
          ]),
          h('p', { class: 'text-xs text-muted truncate' }, displayPhone)
        ])
      ])
    }
  },
  {
    accessorKey: 'orderType',
    header: ({ column }) => {
      const isSorted = column.getIsSorted()
      const icon = !isSorted
        ? 'i-lucide-arrow-up-down'
        : isSorted === 'asc'
          ? 'i-lucide-arrow-up-narrow-wide'
          : 'i-lucide-arrow-down-wide-narrow'

      return h(UButton, {
        label: 'ประเภท',
        color: 'neutral',
        variant: 'ghost',
        class: '-mx-2.5',
        icon,
        onClick: () => cycleColumnSorting(column)
      })
    },
    cell: ({ row }) => {
      const badge = ORDER_TYPE_BADGE_MAP[row.original.orderType]
      const addons = row.original.userPackage?.addons?.filter(a => a.isActive !== false)
      const addonText = addons?.length ? ' + ' + addons.map(a => a.name).join(', ') : ''
      return h(UBadge, { color: badge.color, variant: 'subtle' }, () => badge.label + addonText)
    }
  },
  {
    accessorKey: 'currentStatus',
    header: 'สถานะ',
    cell: ({ row }) => {
      const badge = ORDER_STATUS_BADGE_MAP[row.original.currentStatus]
      return h(UBadge, { color: badge.color, variant: 'subtle' }, () => badge.label)
    }
  },
  {
    accessorKey: 'orderItems',
    header: 'จำนวนผ้า',
    cell: ({ row }) => {
      const orderItems = row.original.orderItems
      if (orderItems?.length === 0) return h('span', { class: 'text-muted' }, '-')
      return h('span', { class: 'text-sm' }, orderItems.length + ' ชิ้น')
    }
  },
  {
    accessorKey: 'hangerCharge',
    header: 'ค่าไม้แขวน',
    cell: ({ row }) => {
      const hangerCharge = row.original.hangerCharge
      if (!hangerCharge) return h('span', { class: 'text-muted' }, '-')
      return h('span', { class: 'text-sm' }, formatCurrency(hangerCharge.total))
    }
  },
  {
    accessorKey: 'amount',
    header: 'ยอดรวม/เครดิต',
    cell: ({ row }) => {
      const order = row.original
      const display = getOrderAmountDisplay(order)
      const isCredit = order.orderType === 'PACKAGE'
      return h('span', {
        class: isCredit ? 'text-primary font-medium' : 'font-medium'
      }, display)
    }
  },
  {
    accessorKey: 'deliveryDate',
    header: ({ column }) => {
      const isSorted = column.getIsSorted()
      const icon = !isSorted
        ? 'i-lucide-arrow-up-down'
        : isSorted === 'asc'
          ? 'i-lucide-arrow-up-narrow-wide'
          : 'i-lucide-arrow-down-wide-narrow'

      return h(UButton, {
        label: 'กำหนดส่ง',
        color: 'neutral',
        variant: 'ghost',
        class: '-mx-2.5',
        icon,
        onClick: () => cycleColumnSorting(column)
      })
    },
    cell: ({ row }) => {
      const deliveryDate = row.original.deliveryDate
      if (!deliveryDate) return h('span', { class: 'text-muted' }, '-')
      return h('span', { class: 'text-sm' }, formatDateTime(deliveryDate))
    }
  },
  {
    accessorKey: 'usedBonuses',
    header: 'โบนัสที่ใช้',
    cell: ({ row }) => {
      const bonuses = row.original.usedBonuses
      if (!bonuses?.length) return h('span', { class: 'text-muted' }, '-')
      return h('div', { class: 'space-y-0.5' },
        bonuses.map((b: UsedBonus) =>
          h('div', { class: 'flex items-center gap-1.5' }, [
            h(UBadge, { color: 'success', variant: 'subtle', size: 'sm' }, () => `x${b.quantity}`),
            h('span', { class: 'text-xs truncate max-w-32' }, b.description)
          ])
        )
      )
    }
  },
  {
    accessorKey: 'employee',
    header: 'พนักงาน',
    cell: ({ row }) => {
      const employee = row.original.employee
      if (!employee) return h('span', { class: 'text-muted' }, '-')
      return h('div', { class: 'flex items-center gap-2' }, [
        h(UAvatar, {
          src: employee.image,
          alt: employee.name,
          size: 'sm'
        }),
        h('span', { class: 'text-sm truncate max-w-24' }, employee.name)
      ])
    }
  },
  {
    accessorKey: 'createdAt',
    header: ({ column }) => {
      const isSorted = column.getIsSorted()
      const icon = !isSorted
        ? 'i-lucide-arrow-up-down'
        : isSorted === 'asc'
          ? 'i-lucide-arrow-up-narrow-wide'
          : 'i-lucide-arrow-down-wide-narrow'

      return h(UButton, {
        label: 'วันที่สร้าง',
        color: 'neutral',
        variant: 'ghost',
        class: '-mx-2.5',
        icon,
        onClick: () => cycleColumnSorting(column)
      })
    },
    cell: ({ row }) => {
      return h('span', { class: 'text-sm text-muted' }, formatDateTime(row.original.createdAt))
    }
  },
  {
    id: 'actions',
    cell: ({ row }) => {
      return h(
        'div',
        { class: 'flex items-center justify-end gap-1.5' },
        [
          h(
            UTooltip,
            { text: 'ดูรายละเอียด' },
            () => h(UButton, {
              icon: 'i-lucide-eye',
              color: 'primary',
              variant: 'subtle',
              size: 'sm',
              onClick: () => navigateTo(`/admin/orders/${row.original.id}`)
            })
          ),
          h(
            UDropdownMenu,
            {
              content: {
                align: 'end'
              },
              items: getRowItems(row)
            },
            () =>
              h(UButton, {
                icon: 'i-lucide-ellipsis-vertical',
                color: 'neutral',
                variant: 'ghost',
                size: 'sm'
              })
          )
        ]
      )
    }
  }
]
</script>

<template>
  <UDashboardPanel id="orders">
    <template #header>
      <UDashboardNavbar title="ออเดอร์" icon="i-lucide-shopping-basket">
        <template #leading>
          <UDashboardSidebarCollapse />
        </template>

        <template #right>
          <UButton label="เพิ่มออเดอร์" icon="i-lucide-shopping-basket" trailing-icon="i-lucide-plus" color="primary"
            @click="navigateTo('/admin/orders/add')" />
        </template>
      </UDashboardNavbar>
    </template>

    <template #body>
      <div class="flex flex-col gap-4">
        <div class="flex flex-wrap items-center justify-between gap-1.5">
          <div class="flex items-center gap-1.5 w-full md:w-auto">
            <UInput v-model="searchQuery" class="w-full md:max-w-lg" icon="i-lucide-search"
              placeholder="ค้นหารหัสออเดอร์ หรือลูกค้า..." />
          </div>

          <div class="flex flex-wrap items-center gap-1.5">
            <UButton v-if="selectedRowsCount" label="ลบ" color="error" variant="subtle" icon="i-lucide-trash"
              @click="openBulkDeleteModal">
              <template #trailing>
                <UKbd>
                  {{ selectedRowsCount }}
                </UKbd>
              </template>
            </UButton>

            <USelect v-model="typeFilter" :items="ORDER_TYPE_FILTER_OPTIONS"
              :ui="{ trailingIcon: 'group-data-[state=open]:rotate-180 transition-transform duration-200' }"
              placeholder="ประเภท" class="min-w-32" />

            <USelect v-model="statusFilter" :items="ORDER_STATUS_FILTER_OPTIONS"
              :ui="{ trailingIcon: 'group-data-[state=open]:rotate-180 transition-transform duration-200' }"
              placeholder="สถานะ" class="min-w-36" />

            <UDropdownMenu class="cursor-pointer" :items="table?.tableApi
              ?.getAllColumns()
              .filter((column: any) => column.getCanHide())
              .map((column: any) => ({
                label: upperFirst(column.id),
                type: 'checkbox',
                checked: column.getIsVisible(),
                onUpdateChecked(checked: boolean) {
                  table?.tableApi?.getColumn(column.id)?.toggleVisibility(!!checked)
                },
                onSelect(e?: Event) {
                  e?.preventDefault()
                }
              }))
              " :content="{ align: 'end' }">
              <UButton label="แสดงคอลัมน์" color="neutral" variant="outline" trailing-icon="i-lucide-settings-2" />
            </UDropdownMenu>
          </div>
        </div>

        <!-- Delete Modal -->
        <UModal v-model:open="showDeleteModal" title="ลบออเดอร์ที่เลือก"
          :description="`ยืนยันการลบออเดอร์ ${selectedRowsCount} รายการ`">
          <template #body>
            <div v-if="selectedOrders.length" class="space-y-3 max-h-72 overflow-auto pr-1">
              <div v-for="order in selectedOrders" :key="order.id" class="flex items-center gap-3">
                <UAvatar :src="order.customer?.image" :alt="order.customer?.name" size="md" />
                <div class="flex-1 min-w-0">
                  <p class="font-medium text-highlighted truncate">
                    {{ order.id }}
                  </p>
                  <p class="text-sm text-muted truncate">
                    {{ order.customer?.name }} - {{ getOrderAmountDisplay(order) }}
                  </p>
                </div>
                <UButton icon="i-lucide-x" variant="ghost" size="xs" color="neutral"
                  @click="handleOrderDeselected(order)" />
              </div>
            </div>
            <p v-else class="text-sm text-muted text-center py-6">
              ยังไม่มีออเดอร์ที่เลือก
            </p>
          </template>

          <template #footer>
            <div class="flex justify-end gap-3 w-full">
              <UButton label="ยกเลิก" color="neutral" variant="outline" @click="showDeleteModal = false" />
              <UButton label="ลบ" color="error" :disabled="!selectedRowsCount" @click="confirmDeleteSelectedOrders" />
            </div>
          </template>
        </UModal>

        <!-- Single Delete Confirm Modal -->
        <UIConfirmModal v-model:open="showSingleDeleteModal" title="ลบออเดอร์" description="ยืนยันการลบออเดอร์นี้"
          icon="i-lucide-trash-2" icon-color="error" confirm-label="ลบออเดอร์" confirm-color="error"
          @confirm="confirmSingleDelete">
          <template #message>
            คุณต้องการลบออเดอร์ <strong class="text-highlighted">{{ deletingOrder?.id }}</strong> หรือไม่?
          </template>
          <template #subMessage>
            <div class="space-y-1">
              <p>
                <span class="text-muted">ลูกค้า:</span>
                <strong class="text-highlighted ml-1">{{ deletingOrder?.customer?.name }}</strong>
              </p>
              <p>
                <span class="text-muted">{{ deletingOrder?.orderType === 'PACKAGE' ? 'เครดิตที่ใช้:' : 'ยอดเงิน:'
                }}</span>
                <strong class="text-highlighted ml-1">{{ deletingOrder ? getOrderAmountDisplay(deletingOrder) : '-'
                }}</strong>
              </p>
            </div>
          </template>
        </UIConfirmModal>

        <!-- Add Order Modal -->

        <UModal v-model:open="showAddOrderModal" title="เพิ่มออเดอร์ใหม่" description="กรอกข้อมูลเพื่อสร้างออเดอร์ใหม่">
          <template #body>
            <div class="space-y-4">
              <!-- Order Type Select -->
              <UFormField name="orderType" label="ประเภทออเดอร์" required>
                <USelect v-model="newOrderForm.orderType" :items="ORDER_TYPE_OPTIONS" placeholder="เลือกประเภทออเดอร์"
                  class="w-full" />
              </UFormField>

              <!-- Customer Select with Search -->
              <UFormField name="customer" label="ลูกค้า" required>
                <UInputMenu v-model="newOrderForm.customerId" v-model:search-term="customerSearchQuery"
                  :items="filteredCustomers.map(c => ({ label: c.name, value: c.id, avatar: { src: c.image ?? undefined, alt: c.name }, description: (c.phoneNumber || c.email) ?? undefined }))"
                  placeholder="ค้นหาลูกค้า..." class="w-full" by="value" value-key="value">
                  <template #leading>
                    <UAvatar v-if="selectedCustomer" :src="selectedCustomer.image" :alt="selectedCustomer.name"
                      size="2xs" />
                    <UIcon v-else name="i-lucide-search" class="size-5 text-muted" />
                  </template>

                  <template #item="{ item }">
                    <div class="flex items-center gap-3">
                      <UAvatar :src="item.avatar?.src" :alt="item.avatar?.alt" size="sm" />
                      <div class="min-w-0">
                        <p class="font-medium truncate">{{ item.label }}</p>
                        <p class="text-xs text-muted truncate">{{ item.description }}</p>
                      </div>
                    </div>
                  </template>

                  <template #empty>
                    <div class="text-center py-4 text-muted">
                      <UIcon name="i-lucide-search-x" class="size-6 mx-auto mb-1 opacity-50" />
                      <p class="text-sm">ไม่พบลูกค้า</p>
                    </div>
                  </template>
                </UInputMenu>
              </UFormField>

              <!-- Notes -->
              <UFormField name="notes" label="หมายเหตุ">
                <UTextarea v-model="newOrderForm.notes" placeholder="หมายเหตุเพิ่มเติม (ถ้ามี)..." :rows="2"
                  class="w-full" />
              </UFormField>
            </div>
          </template>

          <template #footer>
            <div class="flex justify-end gap-3 w-full">
              <UButton label="ยกเลิก" color="neutral" variant="outline" @click="showAddOrderModal = false" />
              <UButton label="สร้างออเดอร์" color="primary" icon="i-lucide-check" :loading="isCreatingOrder"
                @click="handleCreateOrder" />
            </div>
          </template>
        </UModal>

        <UTable ref="table" v-model:column-visibility="columnVisibility" v-model:row-selection="rowSelection"
          v-model:pagination="pagination" :pagination-options="{
            getPaginationRowModel: getPaginationRowModel()
          }" class="shrink-0" :data="filteredOrders" :columns="columns" :loading="status === 'pending'" :ui="{
            base: 'table-fixed border-separate border-spacing-0',
            thead: '[&>tr]:bg-elevated/50 [&>tr]:after:content-none',
            tbody: '[&>tr]:last:[&>td]:border-b-0',
            th: 'py-2 font-medium first:rounded-l-lg last:rounded-r-lg border-y border-default first:border-l last:border-r',
            td: 'border-b border-default',
            separator: 'h-0'
          }">
          <template #empty>
            <div class="flex flex-col items-center justify-center py-12 text-center text-muted">
              <UIcon name="i-lucide-shopping-basket" class="size-10 mb-3 opacity-60" />
              <p>ยังไม่มีออเดอร์ที่ตรงกับการค้นหา</p>
            </div>
          </template>
        </UTable>

        <div class="flex items-center justify-between gap-3 border-t border-default pt-4 mt-auto flex-wrap">
          <div class="text-sm text-muted">
            เลือก {{ selectedRowsCount }} จาก {{ filteredRowCount }} แถวทั้งหมด
          </div>

          <div class="flex items-center gap-1.5">
            <UPagination :default-page="(table?.tableApi?.getState().pagination.pageIndex || 0) + 1"
              :items-per-page="table?.tableApi?.getState().pagination.pageSize" :total="filteredRowCount"
              @update:page="(p: number) => table?.tableApi?.setPageIndex(p - 1)" />
          </div>
        </div>
      </div>
    </template>
  </UDashboardPanel>
</template>