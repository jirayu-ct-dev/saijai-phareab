generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  EMPLOYEE
  ADMIN
}

enum CustomerAccountStatus {
  OFFLINE
  ACTIVE
}

enum PackageType {
  MAIN
  ADDON
}

enum DeductOn {
  CREATED
  COMPLETED
}

enum PackageItemType {
  MAIN
  ADDON
}

enum EntitlementStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum ServiceOrderStatus {
  RECEIVED
  PROCESSING
  DELIVERING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  CANCELLED
}

enum PaymentAuditAction {
  CREATED
  CONFIRMED
  CANCELLED
  SLIP_UPLOADED
  UPDATED
}

model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  name                  String?
  emailVerified         Boolean               @default(false)
  image                 String?
  role                  Role                  @default(USER)
  phoneNumber           String?
  normalizedPhoneNumber String?
  customerAccountStatus CustomerAccountStatus @default(ACTIVE)
  claimedAt             DateTime?
  createdByStaffId      String?
  lineNotifyEnabled     Boolean               @default(true)
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  deletedById           String?
  deletedBy             User?                 @relation("DeletedByUser", fields: [deletedById], references: [id])
  deletedUsers          User[]                @relation("DeletedByUser")
  createdByStaff        User?                 @relation("CustomerCreatedByStaff", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  createdCustomers      User[]                @relation("CustomerCreatedByStaff")

  sessions                   Session[]
  accounts                   Account[]
  claimTokens                CustomerClaimToken[] @relation("CustomerClaimTokenUser")
  createdCustomerClaimTokens CustomerClaimToken[] @relation("CustomerClaimTokenCreatedBy")

  packageSales          PackageSale[]       @relation("PackageSaleCustomer")
  soldPackageSales      PackageSale[]       @relation("PackageSaleSeller")
  serviceOrders         ServiceOrder[]      @relation("ServiceOrderCustomer")
  employeeServiceOrders ServiceOrder[]      @relation("ServiceOrderEmployee")
  memberEntitlements    MemberEntitlement[] @relation("MemberEntitlementOwner")
  paymentRecords        PaymentRecord[]     @relation("PaymentUser")
  confirmedPayments     PaymentRecord[]     @relation("PaymentConfirmedBy")
  paymentAuditLogs      PaymentAuditLog[]   @relation("PaymentAuditActor")
  userAddresses         UserAddress[]
  uploadedImages        Image[]             @relation("ImageOwner")

  deletedPackageProducts        PackageProduct[]        @relation("PackageProductDeletedBy")
  deletedPackageSales           PackageSale[]           @relation("PackageSaleDeletedBy")
  deletedMemberEntitlements     MemberEntitlement[]     @relation("MemberEntitlementDeletedBy")
  deletedStorefrontServices     StorefrontService[]     @relation("StorefrontServiceDeletedBy")
  deletedStorefrontItems        StorefrontItem[]        @relation("StorefrontItemDeletedBy")
  deletedStorefrontPrices       StorefrontPrice[]       @relation("StorefrontPriceDeletedBy")
  deletedStorefrontCategories   StorefrontCategory[]    @relation("StorefrontCategoryDeletedBy")
  deletedImages                 Image[]                 @relation("ImageDeletedBy")
  deletedServiceOrders          ServiceOrder[]          @relation("ServiceOrderDeletedBy")
  deletedServiceOrderItems      ServiceOrderItem[]      @relation("ServiceOrderItemDeletedBy")
  deletedServiceOrderItemImages ServiceOrderItemImage[] @relation("ServiceOrderItemImageDeletedBy")
  deletedPaymentRecords         PaymentRecord[]         @relation("PaymentRecordDeletedBy")
  deletedUserAddresses          UserAddress[]           @relation("UserAddressDeletedBy")
  createdExpenses               Expense[]               @relation("ExpenseCreatedBy")
  updatedExpenses               Expense[]               @relation("ExpenseUpdatedBy")
  deletedExpenses               Expense[]               @relation("ExpenseDeletedBy")
  deletedExpenseCategories      ExpenseCategory[]       @relation("ExpenseCategoryDeletedBy")

  notificationSubscriber NotificationSubscriber?

  @@index([createdByStaffId])
  @@map("user")
}

model CustomerClaimToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("CustomerClaimTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String?
  createdBy   User?     @relation("CustomerClaimTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("customer_claim_token")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Image {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation("ImageOwner", fields: [userId], references: [id])
  assetId     String?
  publicId    String?
  url         String?
  secureUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("ImageDeletedBy", fields: [deletedById], references: [id])

  serviceOrderItemImages ServiceOrderItemImage[] @relation("ServiceOrderItemImageAsset")
  serviceOrders          ServiceOrder[]          @relation("ServiceOrderImage")
  serviceOrderDeliveries ServiceOrder[]          @relation("ServiceOrderDeliveryImage")
  slipPayments           PaymentRecord[]         @relation("PaymentSlipImage")

  @@index([userId])
  @@map("image")
}

model PackageProduct {
  id           String      @id @default(cuid())
  name         String
  description  String?
  packageType  PackageType @default(MAIN)
  isDelivery   Boolean     @default(false)
  deductOn     DeductOn    @default(CREATED)
  price        Decimal
  credits      Int?
  validityDays Int?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  deletedById  String?
  deletedBy    User?       @relation("PackageProductDeletedBy", fields: [deletedById], references: [id])

  saleItems          PackageSaleItem[]
  memberEntitlements MemberEntitlement[]

  @@map("package_product")
}

model PackageSale {
  id             String    @id @default(cuid())
  customerId     String
  customer       User      @relation("PackageSaleCustomer", fields: [customerId], references: [id])
  soldById       String?
  soldBy         User?     @relation("PackageSaleSeller", fields: [soldById], references: [id])
  subtotalAmount Decimal
  discountAmount Decimal   @default(0)
  totalAmount    Decimal
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?     @relation("PackageSaleDeletedBy", fields: [deletedById], references: [id])

  items    PackageSaleItem[]
  payments PaymentRecord[]

  @@index([customerId, createdAt])
  @@map("package_sale")
}

model PackageSaleItem {
  id            String          @id @default(cuid())
  packageSaleId String
  packageSale   PackageSale     @relation(fields: [packageSaleId], references: [id], onDelete: Cascade)
  productId     String
  product       PackageProduct  @relation(fields: [productId], references: [id])
  itemType      PackageItemType
  qty           Int             @default(1)
  unitPrice     Decimal
  totalPrice    Decimal
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  memberEntitlements MemberEntitlement[]

  @@index([packageSaleId])
  @@index([productId])
  @@map("package_sale_item")
}

model MemberEntitlement {
  id               String            @id @default(cuid())
  customerId       String
  customer         User              @relation("MemberEntitlementOwner", fields: [customerId], references: [id])
  sourceSaleItemId String?
  sourceSaleItem   PackageSaleItem?  @relation(fields: [sourceSaleItemId], references: [id])
  productId        String
  product          PackageProduct    @relation(fields: [productId], references: [id])
  status           EntitlementStatus @default(PENDING)
  creditInitial    Int?
  creditRemaining  Int?
  startAt          DateTime?
  endAt            DateTime?
  activatedAt      DateTime?
  suspendedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  deletedById      String?
  deletedBy        User?             @relation("MemberEntitlementDeletedBy", fields: [deletedById], references: [id])

  serviceOrders           ServiceOrder[]
  serviceOrderAddonUsages ServiceOrderAddonUsage[]
  expiryNotifications     PackageExpiryNotification[]

  @@index([customerId])
  @@index([customerId, status])
  @@index([productId])
  @@index([sourceSaleItemId])
  @@index([status, endAt])
  @@map("member_entitlement")
}

model StorefrontCategory {
  id          String    @id @default(cuid())
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("StorefrontCategoryDeletedBy", fields: [deletedById], references: [id])

  storefrontItems StorefrontItem[]

  @@map("storefront_category")
}

model StorefrontService {
  id          String    @id @default(cuid())
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("StorefrontServiceDeletedBy", fields: [deletedById], references: [id])

  storefrontPrices StorefrontPrice[]

  @@map("storefront_service")
}

model StorefrontItem {
  id          String              @id @default(cuid())
  name        String
  description String?
  categoryId  String?
  category    StorefrontCategory? @relation(fields: [categoryId], references: [id])
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?               @relation("StorefrontItemDeletedBy", fields: [deletedById], references: [id])

  storefrontPrices StorefrontPrice[]

  @@map("storefront_item")
}

model StorefrontPrice {
  id                  String            @id @default(cuid())
  storefrontServiceId String
  storefrontService   StorefrontService @relation(fields: [storefrontServiceId], references: [id])
  storefrontItemId    String
  storefrontItem      StorefrontItem    @relation(fields: [storefrontItemId], references: [id])
  price               Decimal
  priceMin            Decimal?
  priceMax            Decimal?
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?
  deletedById         String?
  deletedBy           User?             @relation("StorefrontPriceDeletedBy", fields: [deletedById], references: [id])

  serviceOrderItems ServiceOrderItem[]

  @@unique([storefrontServiceId, storefrontItemId])
  @@map("storefront_price")
}

model ServiceOrder {
  id                         String             @id @default(cuid())
  orderNo                    String?            @unique
  quotationNo                String?            @unique
  customerId                 String
  customer                   User               @relation("ServiceOrderCustomer", fields: [customerId], references: [id])
  employeeId                 String?
  employee                   User?              @relation("ServiceOrderEmployee", fields: [employeeId], references: [id])
  status                     ServiceOrderStatus @default(RECEIVED)
  memberEntitlementId        String?
  memberEntitlement          MemberEntitlement? @relation(fields: [memberEntitlementId], references: [id])
  creditUsed                 Int?
  hangerCharge               Json?
  receivedAt                 DateTime           @default(now())
  // DB-03 expand (plan 4.6/F2/F5): set by the status transition when the
  // order first enters COMPLETED. Legacy completed orders keep NULL — never
  // backfilled from updatedAt or paidAt; display uses a labeled fallback.
  completedAt                DateTime?
  dueAt                      DateTime?
  subtotalAmount             Decimal            @default(0)
  discountAmount             Decimal            @default(0)
  totalAmount                Decimal?
  weightKg                   Decimal?
  washFoldPricePerKgSnapshot Decimal?
  note                       String?
  deliveryAddressSnapshot    Json?
  imageId                    String?
  image                      Image?             @relation("ServiceOrderImage", fields: [imageId], references: [id])
  deliveryImageId            String?
  deliveryImage              Image?             @relation("ServiceOrderDeliveryImage", fields: [deliveryImageId], references: [id])
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  deletedAt                  DateTime?
  deletedById                String?
  deletedBy                  User?              @relation("ServiceOrderDeletedBy", fields: [deletedById], references: [id])

  serviceOrderItems ServiceOrderItem[]
  addonUsageRecords ServiceOrderAddonUsage[]
  payments          PaymentRecord[]

  @@index([customerId])
  @@index([employeeId])
  @@index([memberEntitlementId])
  @@index([orderNo])
  @@index([quotationNo])
  @@index([status, createdAt])
  @@index([status, deletedAt, createdAt])
  @@map("service_order")
}

model ServiceOrderItem {
  id                String           @id @default(cuid())
  serviceOrderId    String
  serviceOrder      ServiceOrder     @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  storefrontPriceId String?
  storefrontPrice   StorefrontPrice? @relation(fields: [storefrontPriceId], references: [id])
  weightKg          Decimal?
  weightLabel       String?
  isPackageIncluded Boolean          @default(false)
  quantity          Int
  unitPrice         Decimal
  totalPrice        Decimal
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  deletedById       String?
  deletedBy         User?            @relation("ServiceOrderItemDeletedBy", fields: [deletedById], references: [id])

  photos ServiceOrderItemImage[]

  @@index([serviceOrderId])
  @@index([storefrontPriceId])
  @@map("service_order_item")
}

model ServiceOrderItemImage {
  id                 String           @id @default(cuid())
  serviceOrderItemId String
  serviceOrderItem   ServiceOrderItem @relation(fields: [serviceOrderItemId], references: [id], onDelete: Cascade)
  imageId            String
  image              Image            @relation("ServiceOrderItemImageAsset", fields: [imageId], references: [id])
  isDamaged          Boolean          @default(false)
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  deletedById        String?
  deletedBy          User?            @relation("ServiceOrderItemImageDeletedBy", fields: [deletedById], references: [id])

  @@index([serviceOrderItemId])
  @@index([imageId])
  @@map("service_order_item_image")
}

model ServiceOrderAddonUsage {
  id                  String             @id @default(cuid())
  serviceOrderId      String
  serviceOrder        ServiceOrder       @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  memberEntitlementId String?
  memberEntitlement   MemberEntitlement? @relation(fields: [memberEntitlementId], references: [id], onDelete: SetNull)
  productId           String?
  productName         String?
  credits             Int
  deductOn            DeductOn           @default(CREATED)
  isDelivery          Boolean            @default(false)
  deductedAt          DateTime?
  refundedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([serviceOrderId])
  @@index([memberEntitlementId])
  @@index([deductOn, deductedAt])
  @@index([refundedAt])
  @@map("service_order_addon_usage")
}

model PaymentRecord {
  id             String         @id @default(cuid())
  paymentNo      String?        @unique
  receiptNo      String?        @unique
  userId         String
  user           User           @relation("PaymentUser", fields: [userId], references: [id])
  packageSaleId  String?
  packageSale    PackageSale?   @relation(fields: [packageSaleId], references: [id])
  serviceOrderId String?
  serviceOrder   ServiceOrder?  @relation(fields: [serviceOrderId], references: [id])
  amount         Decimal
  status         PaymentStatus  @default(UNPAID)
  method         PaymentMethod?
  slipImageId    String?
  slipImage      Image?         @relation("PaymentSlipImage", fields: [slipImageId], references: [id])
  note           String?
  paidAt         DateTime?
  confirmedAt    DateTime?
  confirmedById  String?
  confirmedBy    User?          @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id])
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?          @relation("PaymentRecordDeletedBy", fields: [deletedById], references: [id])

  auditLogs PaymentAuditLog[]

  @@unique([packageSaleId])
  @@unique([serviceOrderId])
  @@index([userId, createdAt])
  @@index([paymentNo])
  @@index([receiptNo])
  @@index([status, createdAt])
  @@map("payment_record")
}

model PaymentAuditLog {
  id         String             @id @default(cuid())
  paymentId  String
  payment    PaymentRecord      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  action     PaymentAuditAction
  actorId    String?
  actor      User?              @relation("PaymentAuditActor", fields: [actorId], references: [id])
  beforeJson Json?
  afterJson  Json?
  note       String?
  createdAt  DateTime           @default(now())

  @@index([paymentId, createdAt])
  @@index([actorId])
  @@map("payment_audit_log")
}

model UserAddress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  address     String?
  subdistrict String?
  district    String?
  province    String?
  postalCode  String?
  latitude    Decimal?
  longitude   Decimal?
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("UserAddressDeletedBy", fields: [deletedById], references: [id])

  @@index([userId])
  @@index([userId, isDefault])
  @@map("user_address")
}

model AppSetting {
  id                 String  @id @default("singleton")
  hangerPricePerUnit Decimal @default(10)
  washFoldPricePerKg Decimal @default(60)
  washFoldMinKg      Decimal @default(0)
  vatRate            Decimal @default(0)
  vatIncluded        Boolean @default(false)
  paymentNoPrefix    String  @default("PAY-")
  orderNoPrefix      String  @default("ORD-")
  quotationNoPrefix  String  @default("QT-")
  receiptNoPrefix    String  @default("RC-")
  minimumOrderAmount Decimal @default(0)
  packageRefundDays  Int     @default(7)

  // Canonical shop identity and notification policy. These fields were
  // backfilled from the former singleton tables before the contract migration.
  name           String  @default("")
  phone          String  @default("")
  address        String  @default("")
  logoUrl        String?
  lineQrImageUrl String?

  notifyCustomerOnQuotation       Boolean @default(true)
  notifyCustomerOnReceived        Boolean @default(true)
  notifyCustomerOnProcessing      Boolean @default(true)
  notifyCustomerOnDelivering      Boolean @default(true)
  notifyCustomerOnCompleted       Boolean @default(true)
  notifyCustomerOnCancelled       Boolean @default(true)
  notifyCustomerReceipt           Boolean @default(true)
  notifyStaffOnNewOrder           Boolean @default(true)
  notifyCustomerOnPackageExpiring Boolean @default(true)

  // print/QR (canonical fields; server-only, never serialized to browsers raw)
  lineQrEnabled               Boolean   @default(false)
  paymentQrEnabled            Boolean?
  paymentQrProvider           String? // PROMPTPAY_LOCAL | BANK_MERCHANT (validated by Zod, not a DB enum)
  paymentQrReceiverType       String? // MOBILE | NATIONAL_OR_TAX_ID | EWALLET
  paymentQrReceiverCiphertext String? // encrypted at rest; plaintext never stored
  paymentQrReceiverLast4      String?
  paymentQrReceiverLabel      String?
  paymentQrKeyVersion         Int?
  paymentQrConfigVersion      Int?
  paymentQrActivatedAt        DateTime?
  paymentQrActivatedById      String? // actor reference without FK to keep the expand surface minimal
  paymentQrUpdatedById        String?

  updatedAt DateTime @updatedAt

  @@map("business_setting")
}

model PackageExpiryNotification {
  id            String            @id @default(cuid())
  entitlementId String
  entitlement   MemberEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  daysBefore    Int
  endAtSnapshot DateTime
  sentAt        DateTime          @default(now())

  @@unique([entitlementId, daysBefore, endAtSnapshot])
  @@index([sentAt])
  @@map("package_expiry_notification")
}

model NotificationSubscriber {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive            Boolean  @default(true)
  receiveNewOrder     Boolean  @default(true)
  receiveStatusChange Boolean  @default(true)
  receiveReceipt      Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("notification_subscriber")
}

model ExpenseCategory {
  id             String    @id @default(cuid())
  name           String
  normalizedName String    @unique
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?     @relation("ExpenseCategoryDeletedBy", fields: [deletedById], references: [id])

  expenses Expense[]

  @@index([isActive, deletedAt])
  @@map("expense_category")
}

model Expense {
  id          String          @id @default(cuid())
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount      Decimal         @db.Decimal(12, 2)
  expenseAt   DateTime
  description String?
  createdById String
  createdBy   User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?           @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?           @relation("ExpenseDeletedBy", fields: [deletedById], references: [id])

  @@index([expenseAt, deletedAt])
  @@index([categoryId, expenseAt])
  @@index([createdById])
  @@map("expense")
}
